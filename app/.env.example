# Copy to .env and fill in. Only EXPO_PUBLIC_ values belong here — they are
# compiled into the app bundle and are visible to anyone who has it.
# The Supabase *secret* key must never appear in this file or anywhere in app/.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_AGENT_API_URL=
